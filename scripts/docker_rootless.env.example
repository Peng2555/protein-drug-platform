# Docker Rootless — 复制为 scripts/docker_rootless.env（该文件已被 git 忽略）
# 将下面的 1016 替换为你的 UID：id -u

export DOCKER_HOST=unix:///run/user/1016/docker.sock
export PATH=/usr/bin:$PATH

# 可选：确保 user docker 守护进程已启动
if ! systemctl --user is-active --quiet docker.service 2>/dev/null; then
  systemctl --user start docker.service 2>/dev/null || true
fi
