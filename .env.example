# Web platform (API binds 0.0.0.0 by default — LAN: http://<server-ip>:8765/)
PORT=8765

# 用户注册：允许自助注册，新用户需管理员审批（scripts/manage_users.py approve）
ALLOW_REGISTRATION=true
REGISTRATION_REQUIRES_APPROVAL=true
DATABASE_URL=postgresql+psycopg2://boltz:boltz@127.0.0.1:5433/boltzfold
REDIS_URL=redis://127.0.0.1:6380/0
SECRET_KEY=change-me-to-a-long-random-string
BOLTZ2_OUT_ROOT=/home/pengpai/data/Company_Project/Boltz2/outputs
BOLTZ_CACHE=/home/pengpai/data/cache/boltz
HF_HOME=/home/pengpai/data/cache/huggingface
TORCH_HOME=/home/pengpai/data/cache/torch
BOLTZ_BIN=/home/pengpai/data/envs/boltz2/bin/boltz
ESMFOLD_PY=/home/pengpai/data/envs/esmfold2/bin/python
ESMFOLD_MODEL=biohub/ESMFold2
# Optional: first admin (created by init_db.py if no users exist)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
HMMER_PATH=/home/pengpai/data/envs/IgGM/bin
# Parallel GPU workers (one Celery process per GPU, concurrency=1 each)
CELERY_GPU_COUNT=4
# Max single jobs queued+running per user (batch jobs exempt)
CELERY_GPU_COUNT=4
CELERY_GPU_QUEUE=gpu
MAX_JOBS_PER_USER_QUEUED=0
# VHH batch panel: max heavy chains per submit (default 5000)
MAX_VHH_PANEL_SIZE=5000
MD_PRODUCTION_NS=1
MD_REPLICAS=1
GMX_BIN=/home/pengpai/data/envs/IgGM/bin/gmx
GEMMI_PY=/home/pengpai/data/envs/IgGM/bin/python
