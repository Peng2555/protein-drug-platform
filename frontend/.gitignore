# 前端本地忽略（根目录 .gitignore 已覆盖大部分规则，此处供在 frontend/ 内单独开发时使用）

# 依赖与构建
node_modules
dist
dist-ssr
.vite
*.tsbuildinfo

# unplugin 自动生成（npm run dev / build 会重建）
src/auto-imports.d.ts
src/components.d.ts

# 日志
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# 本地环境
*.local

# 编辑器
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
